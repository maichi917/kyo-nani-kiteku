<%#
  天気カードの中身。トップとホームで使い回す
  locals:
    place_name, date, max_temp, min_temp, yesterday_max_temp, precipitation_probability：場所と天気
    outfit：おすすめの服装（:cardigan など）／ judgment：Outfit::Judge の結果（傘・暑さ・寒暖差）
    comment：服装名の下に出す一言（トップは服装ごとの説明文、ホームは AI の一言）
    show_line_invite：LINE 登録の案内を出すか（ログイン前のトップだけ true）
%>
  <div class="weather-card-head">
    <h2 class="weather-place"><%= place_name %></h2>
    <p class="weather-date"><%= date.strftime("%-m月%-d日") %>（<%= %w[日 月 火 水 木 金 土][date.wday] %>）</p>
  </div>

  <dl class="temps">
    <div class="temp">
      <dt>最高</dt>
      <dd class="temp-max"><%= max_temp.round %>℃</dd>
    </div>
    <div class="temp">
      <dt>最低</dt>
      <dd class="temp-min"><%= min_temp.round %>℃</dd>
    </div>
    <div class="temp">
      <dt>降水確率</dt>
      <dd><%= precipitation_probability.to_i %>%</dd>
    </div>
  </dl>

  <%# 昨日の最高気温との差。画面に出している四捨五入後の気温どうしで比べる %>
  <% diff = max_temp.round - yesterday_max_temp.round %>
  <p class="yesterday">
    <span class="yesterday-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <% if diff.positive? %>
          <path d="M12 19V5"></path><path d="M6 11l6-6 6 6"></path>
        <% elsif diff.negative? %>
          <path d="M12 5v14"></path><path d="M6 13l6 6 6-6"></path>
        <% else %>
          <path d="M5 12h14"></path>
        <% end %>
      </svg>
    </span>
    <% if diff.zero? %>
      昨日と同じくらい
    <% else %>
      昨日より <strong><%= diff.abs %>℃</strong> <%= diff.positive? ? "高い" : "低い" %>
    <% end %>
    <span class="yesterday-max">昨日の最高 <%= yesterday_max_temp.round %>℃</span>
  </p>

  <div class="outfit">
    <%# 服装ごとのイラスト（app/assets/images/outfits/ に、服装の名前と同じファイル名で置いている） %>
    <div class="outfit-icon" aria-hidden="true">
      <%= image_tag "outfits/#{outfit}.png", alt: "", width: 64, height: 64 %>
    </div>
    <div class="outfit-body">
      <p class="outfit-name"><%= Outfit.label(outfit) %></p>
      <p class="outfit-description"><%= comment %></p>
      <div class="badges">
        <% if judgment.heat_level %>
          <span class="badge badge-<%= judgment.heat_level %>"><%= Outfit::Judge.heat_label(judgment.heat_level) %></span>
        <% end %>
        <% if judgment.temperature_gap %>
          <span class="badge badge-gap">寒暖差あり</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# ログイン前のトップだけ、LINE 登録の案内を出す %>
  <% if show_line_invite %>
    <p class="ai-comment-placeholder">LINE登録すると、毎朝ひとことメッセージが届きます🎶</p>
  <% end %>

  <%# 傘の帯はカードの一番下（画面イメージどおり）。雨が降らなさそうな日も帯を出して安心してもらう %>
  <% if judgment.umbrella %>
    <p class="umbrella">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z"></path><path d="M12 12v6a2 2 0 0 0 4 0"></path></svg>
      雨の可能性あり。傘を持っていこう
    </p>
  <% else %>
    <p class="sunny">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      今日は雨は降らなさそうです！
    </p>
  <% end %>
