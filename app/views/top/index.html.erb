<main class="page<%= " page-with-tabs" if logged_in? %>">
  <header class="page-header">
    <h1 class="brand">今日なに着てく？</h1>
    <% if logged_in? %>
      <%# タイトルの下の行に、右寄せで LINE のアイコン。押すとホームへ %>
      <div class="account">
        <%= link_to home_path, class: "account-link", aria: { label: "ホーム" } do %>
          <% if current_user.picture_url.present? %>
            <%= image_tag current_user.picture_url, alt: "", class: "account-icon" %>
          <% else %>
            <%# LINE のアイコンを設定していない人には、人の形の線画を出す %>
            <span class="account-icon account-icon-default">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <p class="tagline">あの場所の今日の天気とおすすめの服装をチェックしよう！</p>
  </header>

  <section class="search" aria-label="地名で検索">
    <%# 送信すると /places?q=… の結果で、下の候補の枠（place_candidates）だけが差し替わる %>
    <%= form_with url: places_path, method: :get, data: { turbo_frame: "place_candidates" }, class: "search-form" do |f| %>
      <%= f.label :q, "地名で検索", class: "search-label" %>
      <div class="search-row">
        <%= f.search_field :q, placeholder: "例：渋谷区、東京都中央区", class: "search-input", autocomplete: "off" %>
        <%= f.submit "検索", class: "search-button", name: nil %>
      </div>
    <% end %>

    <%# 候補が入る枠。最初は空っぽ %>
    <%= turbo_frame_tag "place_candidates" %>
  </section>

  <section class="weather-card" aria-label="今日の天気と服装">
    <% if @error %>
      <p class="weather-error"><%= @error %></p>
    <% else %>
      <%= render "shared/weather_card",
                 place_name: @place.name, date: @forecast.date,
                 max_temp: @forecast.max_temp, min_temp: @forecast.min_temp,
                 yesterday_max_temp: @forecast.yesterday_max_temp,
                 precipitation_probability: @forecast.precipitation_probability,
                 outfit: @judgment.outfit, judgment: @judgment,
                 comment: Outfit.description(@judgment.outfit),
                 show_line_invite: !logged_in? %>

    <% end %>
  </section>

  <%# ログイン前だけ LINE 登録の案内を出す %>
  <% unless logged_in? %>
  <section class="line-cta" aria-label="LINE で受け取る">
      <%= image_tag "kyonanichan.png", alt: "今日なにちゃん", class: "line-cta-character", width: 300, height: 300 %>
      <p class="line-cta-lead">今日なにちゃんから LINE が届くよ</p>
      <p class="line-cta-title">毎朝7時にLINEでメッセージを受け取れます</p>
      <%# Turbo を使わず普通のページ移動にする（LINE のサイトへ移動するため） %>
      <%= link_to "LINEでログイン", line_login_path, class: "line-button", data: { turbo: false } %>
      <p class="line-cta-note">ログイン時に公式アカウントの友だち追加をお願いします</p>
  </section>
  <% end %>

  <%= render "shared/legal_links" %>

  <%# ログイン中は、下にタブを出す（ここは「さがす」の画面） %>
  <% if logged_in? %>
    <%= render "shared/tab_bar", current: :search %>
  <% end %>
</main>
