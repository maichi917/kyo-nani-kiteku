<main class="page">
  <header class="page-header">
    <h1 class="brand">今日なに着てく？</h1>
    <% if logged_in? %>
      <%# タイトルの下の行に、右寄せで LINE のアイコン。ログアウトは #6 で設定画面に移す %>
      <div class="account">
        <% if current_user.picture_url.present? %>
          <%= image_tag current_user.picture_url, alt: "#{current_user.name} さん", class: "account-icon" %>
        <% else %>
          <%# LINE のアイコンを設定していない人には、人の形の線画を出す %>
          <span class="account-icon account-icon-default" role="img" aria-label="<%= current_user.name %> さん">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
          </span>
        <% end %>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "logout-button" %>
      </div>
    <% end %>
    <p class="tagline">あの場所の今日の天気とおすすめの服装をチェックしよう！</p>
  </header>

  <section class="search" aria-label="地名で検索">
    <%# 送信すると /places?q=… の結果で、下の候補の枠（place_candidates）だけが差し替わる %>
    <%= form_with url: places_path, method: :get, data: { turbo_frame: "place_candidates" }, class: "search-form" do |f| %>
      <%= f.label :q, "地名で検索", class: "search-label" %>
      <div class="search-row">
        <%= f.search_field :q, placeholder: "例：渋谷区、東京都中央区", class: "search-input", autocomplete: "off" %>
        <%= f.submit "検索", class: "search-button", name: nil %>
      </div>
    <% end %>

    <%# 候補が入る枠。最初は空っぽ %>
    <%= turbo_frame_tag "place_candidates" %>
  </section>

  <section class="weather-card" aria-label="今日の天気と服装">
    <% if @error %>
      <p class="weather-error"><%= @error %></p>
    <% else %>
      <div class="weather-card-head">
        <h2 class="weather-place"><%= @place.name %>の今日</h2>
        <p class="weather-date"><%= @forecast.date.strftime("%-m月%-d日") %>（<%= %w[日 月 火 水 木 金 土][@forecast.date.wday] %>）</p>
      </div>

      <dl class="temps">
        <div class="temp">
          <dt>最高</dt>
          <dd class="temp-max"><%= @forecast.max_temp.round %>℃</dd>
        </div>
        <div class="temp">
          <dt>最低</dt>
          <dd class="temp-min"><%= @forecast.min_temp.round %>℃</dd>
        </div>
        <div class="temp">
          <dt>降水確率</dt>
          <dd><%= @forecast.precipitation_probability.to_i %>%</dd>
        </div>
      </dl>

      <%# 傘はいちばん大事なので、気温のすぐ下に目立つ帯で出す %>
      <% if @judgment.umbrella %>
        <p class="umbrella">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z"></path><path d="M12 12v6a2 2 0 0 0 4 0"></path></svg>
          雨の可能性あり。傘を持っていこう
        </p>
      <% end %>

      <%# 昨日の最高気温との差。画面に出している四捨五入後の気温どうしで比べる %>
      <% diff = @forecast.max_temp.round - @forecast.yesterday_max_temp.round %>
      <p class="yesterday">
        <span class="yesterday-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <% if diff.positive? %>
              <path d="M12 19V5"></path><path d="M6 11l6-6 6 6"></path>
            <% elsif diff.negative? %>
              <path d="M12 5v14"></path><path d="M6 13l6 6 6-6"></path>
            <% else %>
              <path d="M5 12h14"></path>
            <% end %>
          </svg>
        </span>
        <% if diff.zero? %>
          昨日と同じくらい
        <% else %>
          昨日より <strong><%= diff.abs %>℃</strong> <%= diff.positive? ? "高い" : "低い" %>
        <% end %>
        <span class="yesterday-max">昨日の最高 <%= @forecast.yesterday_max_temp.round %>℃</span>
      </p>

      <div class="outfit">
        <div class="outfit-icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l-5 3 2 4 2-1v12h10V9l2 1 2-4-5-3c-.5 1.5-2 2.5-4 2.5S8.5 4.5 8 3z"></path></svg>
        </div>
        <div class="outfit-body">
          <p class="outfit-name"><%= Outfit.label(@judgment.outfit) %></p>
          <p class="outfit-description"><%= Outfit.description(@judgment.outfit) %></p>
          <div class="badges">
            <% if @judgment.heat_level %>
              <span class="badge badge-<%= @judgment.heat_level %>"><%= Outfit::Judge.heat_label(@judgment.heat_level) %></span>
            <% end %>
            <% if @judgment.temperature_gap %>
              <span class="badge badge-gap">寒暖差あり</span>
            <% end %>
          </div>
        </div>
      </div>

      <%# ログイン前だけ案内を出す。ログイン後のホームでは、ここに AI の一言が入る（#7・#8） %>
      <% unless logged_in? %>
        <p class="ai-comment-placeholder">LINE登録すると、毎朝ひとことメッセージが届きます🎶</p>
      <% end %>

    <% end %>
  </section>

  <%# ログイン前だけ LINE 登録の案内を出す %>
  <% unless logged_in? %>
  <section class="line-cta" aria-label="LINE で受け取る">
      <p class="line-cta-title">毎朝7時にLINEでメッセージを受け取れます</p>
      <%# Turbo を使わず普通のページ移動にする（LINE のサイトへ移動するため） %>
      <%= link_to "LINEでログイン", line_login_path, class: "line-button", data: { turbo: false } %>
      <p class="line-cta-note">ログイン時に公式アカウントの友だち追加をお願いします</p>
  </section>
  <% end %>
</main>
